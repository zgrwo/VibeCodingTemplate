# ============================================================================
# benchmarks.yml.template — 性能基准 workflow 模板
#
# 用法：按项目语言保留一个 job，重命名为 benchmarks.yml（去掉 .template）启用。
# 定位：非门禁——只做趋势与回归告警（共享 runner 抖动大，硬阈值必然误伤）；
#       结果作为构件上传对比，历史可用 actions/cache 持久化。
# 指标口径与编写约定见 benchmarks/README.md（唯一信源）。
# ============================================================================
name: Benchmarks

on:
  push:
    paths:
      - "src/**"
      - "benchmarks/**"
      - ".github/workflows/benchmarks.yml"
  schedule:
    - cron: "0 3 * * 1" # 每周一 03:00 UTC（与参考项目一致）
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: benchmarks-${{ github.ref }}
  cancel-in-progress: true

jobs:
  # --------------------------------------------------------------------------
  # Python（pytest-benchmark）：默认保留本 job 示例
  # --------------------------------------------------------------------------
  python-benchmarks:
    name: Python Benchmarks
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: "3.12"
      - name: 安装依赖（含基准工具）
        run: python -m pip install -e ".[dev]" pytest-benchmark
      - name: 运行基准
        # --benchmark-max-time 限单基准时长，防 CI 超时；不可避免的系统噪声见 README
        run: python -m pytest benchmarks/ --benchmark-only --benchmark-max-time=1.0 --benchmark-json=benchmark.json
      - name: 上传基准结果（构件保留 90 天）
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: python-benchmarks-${{ github.sha }}
          path: benchmark.json
          retention-days: 90

  # --------------------------------------------------------------------------
  # C#（BenchmarkDotNet）：启用时删除上方 python job
  # --------------------------------------------------------------------------
