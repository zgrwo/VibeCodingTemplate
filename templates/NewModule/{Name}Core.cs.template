using System;
using System.Runtime.CompilerServices;

// 测试程序集可访问 internal Core：Core 层按 csharp-SKILL 设计为 internal，
// 但单元测试项目位于独立程序集 {Module}.Tests（tests/{Module}.Tests/），
// 需显式声明 friend assembly，否则生成项目编译报 CS0122（内部类型不可访问）。
[assembly: InternalsVisibleTo("{Module}.Tests")]

namespace {{ROOT_NAMESPACE}}.{Module}
{
    /// <summary>
    /// {一句话模块功能说明}
    /// </summary>
    internal static class {Name}Core
    {
        // ====================================================================
        // 哨兵契约 (L1-L5)：
        //   L1: 参数转换失败 → 返回类型零值（double→NaN, string→""）
        //   L2: 除零 → NaN（不抛异常）
        //   L3: 空集合 → NaN（不抛异常）
        //   L4: 溢出 → NaN（不抛异常）
        //   L5: 未知类型 Convert 失败 → throw
        // ====================================================================

        /// <summary>
        /// {函数功能}
        /// </summary>
        /// <param name="input">输入值</param>
        /// <returns>计算结果；无效输入返回 NaN</returns>
        internal static double Compute(double input)
        {
            // 1. 静默传播阻断：NaN/Inf 显式守卫
            if (double.IsNaN(input) || double.IsInfinity(input))
                return double.NaN;

            // 2. 防御完整性：领域约束前置验证
            // if (input < 0) return double.NaN;

            // 3. 核心逻辑
            double result = input; // TODO: 替换为实际计算

            // 4. 结果守卫：防止中间步骤产生 Inf
            if (double.IsInfinity(result))
                return double.NaN;

            return result;
        }

        /// <summary>
        /// 未知类型转换入口（Udf 层把 Variant 传入后走此重载）。
        /// 哨兵契约 L5：无法转换为 double → throw ArgumentException（不静默替代）。
        /// </summary>
        /// <param name="input">未知类型输入</param>
        /// <returns>转换后的数值结果</returns>
        internal static double Compute(object input)
        {
            if (input is double d)
                return Compute(d);
            if (input is IConvertible conv)
            {
                try
                {
                    return Compute(Convert.ToDouble(conv));
                }
                catch (Exception e) when (e is FormatException or InvalidCastException or OverflowException)
                {
                    throw new ArgumentException("输入无法转换为数值", nameof(input), e);
                }
            }
            throw new ArgumentException("输入不是数值类型", nameof(input));
        }

        /// <summary>
        /// {字符串处理功能}
        /// </summary>
        /// <param name="text">输入文本</param>
        /// <returns>处理结果；null/空返回空串</returns>
        internal static string Process(string text)
        {
            // 哨兵契约：null → ""
            if (text == null)
                return "";

            // TODO: 实现处理逻辑
            return text.Trim();
        }
    }
}
