using System;
using ExcelDna.Integration;

namespace {{ROOT_NAMESPACE}}.Foundation
{
    /// <summary>
    /// 输入归一化：把 Excel 传入的 object 转换为强类型值。
    /// 哨兵契约：无法转换时返回类型零值（不抛异常，交给 WrapError 统一处理）。
    /// </summary>
    internal static class InputNormalizer
    {
        public static double ToDouble(object value) => value switch
        {
            double d => d,
            int i => i,
            long l => l,
            string s when double.TryParse(s, out var d) => d,
            _ => double.NaN,
        };

        public static string ToString(object value) => value switch
        {
            null => "",
            string s => s,
            double d => d.ToString(),
            _ => Convert.ToString(value, System.Globalization.CultureInfo.InvariantCulture) ?? "",
        };
    }

    /// <summary>
    /// 逐元素映射：数组/单值统一展开，元素级执行 Func，输出同形结构。
    /// </summary>
    internal static class ElementWiseMapper
    {
        public static object MapOver<TIn, TOut>(object value, Func<TIn, TOut> func)
        {
            if (value is object[,] arr)
            {
                var result = new object[arr.GetLength(0), arr.GetLength(1)];
                for (int r = 0; r < arr.GetLength(0); r++)
                for (int c = 0; c < arr.GetLength(1); c++)
                    result[r, c] = func(ToT<TIn>(arr[r, c]));
                return result;
            }
            if (value is object[] oneDim)
            {
                var result = new object[oneDim.Length];
                for (int i = 0; i < oneDim.Length; i++)
                    result[i] = func(ToT<TIn>(oneDim[i]));
                return result;
            }
            return func(ToT<TIn>(value));
        }

        private static T ToT<T>(object v)
        {
            if (v is T t)
                return t;
            // 哨兵契约：数值类型转换失败 → NaN（返回类型零值 0.0 会静默参与计算，
            // 污染统计结果；csharp-SKILL 明确禁止 `return default(T)`）。
            // 非数值类型仍返回零值（string → null，WrapError 无法捕获非异常场景）。
            if (typeof(T) == typeof(double))
                return (T)(object)double.NaN;
            if (typeof(T) == typeof(float))
                return (T)(object)float.NaN;
            return default!;
        }
    }

    /// <summary>
    /// 错误包装：UDF 内部异常统一转为 #VALUE!（不抛异常，不中断公式）。
    /// 与防错三原则配合：异常过滤器排除不可恢复异常（OOM / StackOverflow / AccessViolation）。
    /// </summary>
    internal static class OutputWrapper
    {
        public static object WrapError(Func<object> func)
        {
            try
            {
                return func();
            }
            catch (Exception ex) when (ex is not OutOfMemoryException
                                       and not StackOverflowException
                                       and not AccessViolationException)
            {
                return ExcelError.ExcelErrorValue;
            }
        }
    }
}
