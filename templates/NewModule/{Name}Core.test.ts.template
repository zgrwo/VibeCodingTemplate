// ============================================================================
// {Name}Core.test.ts — 核心层单元测试
// 使用方式：将 {Name} 替换为模块名
// 目标位置：tests/{Module}/{Name}Core.test.ts
// 运行：npx vitest run tests/{Module}/
// 注意：文件名后缀必须为 .test.ts（vitest/Jest 默认 glob **/*.{test,spec}.*），
//       否则测试文件不会被测试运行器发现。
// ============================================================================

import { describe, it, expect } from "vitest";
// 相对导入 src/（tests/{Module}/ → src/{Module}/），避免裸 specifier 无法解析
import { compute, process } from "../../src/{Module}/{Name}Core";

describe("{Name}Core", () => {
  // ========== compute ==========

  describe("compute", () => {
    it("正常输入返回正确结果", () => {
      expect(compute(5)).toBe(10);
    });

    it("0 是有效值（不误判为 falsy）", () => {
      expect(compute(0)).toBe(0);
    });

    it("null 返回 NaN（哨兵契约）", () => {
      expect(Number.isNaN(compute(null))).toBe(true);
    });

    it("undefined 返回 NaN（哨兵契约）", () => {
      expect(Number.isNaN(compute(undefined))).toBe(true);
    });

    it("NaN 返回 NaN（防御性）", () => {
      expect(Number.isNaN(compute(NaN))).toBe(true);
    });

    it("Infinity 返回 NaN（防御性）", () => {
      expect(Number.isNaN(compute(Infinity))).toBe(true);
    });

    it("-Infinity 返回 NaN（防御性）", () => {
      expect(Number.isNaN(compute(-Infinity))).toBe(true);
    });
  });

  // ========== process ==========

  describe("process", () => {
    it("正常输入返回处理结果", () => {
      expect(process("  hello  ")).toBe("hello");
    });

    it("空串返回空串（有效输入）", () => {
      expect(process("")).toBe("");
    });

    it("null 返回空串（哨兵契约）", () => {
      expect(process(null)).toBe("");
    });

    it("undefined 返回空串（哨兵契约）", () => {
      expect(process(undefined)).toBe("");
    });
  });
});
