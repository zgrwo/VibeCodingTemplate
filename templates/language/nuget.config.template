<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================================
  nuget.config.template — NuGet 源配置
  使用方式：复制到解决方案根目录，替换 {{...}} 占位符
  作用：统一包源 + 包源映射（防止私有包被公共源误解析）
  参考：ExcelAddin 函数库 nuget.config（已验证有效）
============================================================================ -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- 如需私有源（GitHub Packages 等），取消注释并替换：
    <add key="github" value="https://nuget.pkg.github.com/{{OWNER}}/index.json" />
    -->
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!-- 与上方私有源成对启用：
    <packageSource key="github">
      <package pattern="{{PRIVATE_PACKAGE_PREFIX}}.*" />
    </packageSource>
    -->
  </packageSourceMapping>
</configuration>
