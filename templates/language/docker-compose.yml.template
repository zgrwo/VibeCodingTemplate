# ============================================================================
# docker-compose.yml.template — 开发环境编排
# 使用方式：复制到项目根目录，替换 {{...}} 占位符
# 启动：docker compose up -d
# 关闭：docker compose down
# ============================================================================

services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
    ports:
      - "{{APP_PORT}}:8080"
    environment:
      - NODE_ENV=development
      # - PYTHONPATH=/app:/app/site-packages
    volumes:
      # 开发模式挂载源码（生产镜像不挂载）
      - ./src:/app/src:ro
    restart: unless-stopped
    healthcheck:
      # 注：运行时镜像为 distroless（无 curl），用 python urllib 探测
      #     （与 Dockerfile.template 注释的健康检查一致）。
      #     Node/Go 项目可改用 Node 或语言原生探测，或为镜像加装 curl。
      test: ["CMD", "python", "-c", "import urllib.request,sys; sys.exit(0) if urllib.request.urlopen('http://localhost:8080/health').status==200 else sys.exit(1)"]
      interval: 30s
      timeout: 3s
      retries: 3
      start_period: 5s

