# ============================================================================
# .gitattributes — 换行符统一与二进制标记
# 参考：ExcelVBA 函数库（已验证有效）
# 语言特定规则（如 VBA 的 *.cls eol=crlf）在初始化时按需追加
# ============================================================================

# 文档 → LF（web 渲染友好）
*.md text eol=lf
*.txt text eol=lf

# Python / Shell 脚本 → LF
*.py text eol=lf
*.sh text eol=lf
*.bash text eol=lf

# 脚手架模板文件（源码级占位符，复制到 src/ 使用）→ LF
*.template text eol=lf

# TOML / 无扩展名根配置 → LF（2026-08 Max 审查补充，防 Windows autocrlf 漂移）
*.toml text eol=lf
.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf

# git hooks（无扩展名，POSIX 脚本，core.hooksPath）→ LF
scripts/git-hooks/* text eol=lf

# PowerShell 脚本 → CRLF（Windows 惯例，配合 UTF-8 with BOM）
*.ps1 text eol=crlf

# C# / 配置 → LF
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf

# TypeScript / JavaScript → LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# Go → LF
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf

# Dockerfile → LF
Dockerfile text eol=lf
Dockerfile.* text eol=lf

# Makefile → LF
Makefile text eol=lf

# 二进制 → 不做任何转换
*.dll binary
*.pdb binary
*.xlsm binary
*.xlam binary
*.xlsx binary
*.xls binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.db binary
*.pdf binary
